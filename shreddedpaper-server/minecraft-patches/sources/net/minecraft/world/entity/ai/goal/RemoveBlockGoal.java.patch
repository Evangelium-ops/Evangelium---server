+    // Knowledge start - one search touches thousands of blocks of a few chunks; it runs at once on the owning thread, so a chunk cannot go away during it
+    private @Nullable ChunkAccess scanChunk;
+    private boolean scanning;
+
+    @Override
+    protected boolean findNearestBlock() {
+        if (!io.multipaper.shreddedpaper.ai.AiDiagnostics.goalOptimizationEnabled()) {
+            return super.findNearestBlock();
+        }
+        this.scanning = true;
+        try {
+            return super.findNearestBlock();
+        } finally {
+            this.scanning = false;
+            this.scanChunk = null;
+        }
+    }
+
+    private @Nullable ChunkAccess chunkAt(LevelReader level, BlockPos pos) {
+        int x = pos.getX() >> 4, z = pos.getZ() >> 4;
+        ChunkAccess chunk = this.scanChunk;
+        if (chunk != null && chunk.getPos().x == x && chunk.getPos().z == z) {
+            return chunk;
+        }
+        chunk = level.getChunkIfLoadedImmediately(x, z); // Paper - Prevent AI rules from loading chunks
+        if (this.scanning) {
+            this.scanChunk = chunk;
+        }
+        return chunk;
+    }
