+    private void updateDistanceTracking(long section) { // ShreddedPaper - synchronized
+        // Knowledge: every region thread of the world shares this lock, and chunk unloads call this for all ~24 sections of a chunk.
+        // The village check reads only the caller's own section, so it runs before the lock; a section that is not a village centre
+        // and was not a source has nothing to change (removeSource would be a no-op) and never takes the lock at all.
+        boolean center = this.isVillageCenter(section);
+        if (!center && !this.villageSources.contains(section)) {
+            return;
+        }
+        synchronized (this) {
+            if (center) {
+                this.villageDistanceTracker.setSource(section, POI_DATA_SOURCE);
+                this.villageSources.add(section);
+            } else {
+                this.villageDistanceTracker.removeSource(section);
+                this.villageSources.remove(section);
+            }
         }
     }
 
