+        long[] knowledgePlayerChunks(ServerLevel level) { // built once by the first region thread that needs it (a race only builds it twice)
+            long[] chunks = this.knowledgePlayerChunks;
+            if (chunks == null) {
+                final it.unimi.dsi.fastutil.longs.LongLinkedOpenHashSet set = new it.unimi.dsi.fastutil.longs.LongLinkedOpenHashSet();
+                for (net.minecraft.server.level.ServerPlayer player : level.players()) {
+                    set.add(player.chunkPosition().toLong());
+                }
