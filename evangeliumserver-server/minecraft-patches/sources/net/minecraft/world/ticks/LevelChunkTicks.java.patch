+            return i;
+        }
+        i = Integer.compare(PackedTicks.priorityOrdinal(wordA), PackedTicks.priorityOrdinal(wordB));
+        return i != 0 ? i : Long.compare(subA, subB);
+    }
+
+    /** PriorityQueue.offer + siftUpUsingComparator. Returns true when the new entry is the head. */
+    private boolean heapOffer(long trig, long sub, long word) {
+        int k = this.hSize;
+        this.ensureHeapCapacity(k + 1);
+        long[] t = this.hTrig;
+        long[] s = this.hSub;
+        long[] w = this.hWord;
+        while (k > 0) {
+            int parent = (k - 1) >>> 1;
+            if (compare(trig, word, sub, t[parent], w[parent], s[parent]) >= 0) {
+                break;
+            }
+            t[k] = t[parent];
+            s[k] = s[parent];
+            w[k] = w[parent];
+            k = parent;
+        }
+        t[k] = trig;
+        s[k] = sub;
+        w[k] = word;
+        this.hSize++;
+        return k == 0;
+    }
+
+    /** PriorityQueue.poll + siftDownUsingComparator (the caller took the head object first). */
+    private void heapPoll() {
+        this.head = null;
+        int n = --this.hSize;
+        if (n > 0) {
+            long[] t = this.hTrig;
+            long[] s = this.hSub;
+            long[] w = this.hWord;
+            long xt = t[n];
+            long xs = s[n];
+            long xw = w[n];
+            int k = 0;
+            int half = n >>> 1;
+            while (k < half) {
+                int child = (k << 1) + 1;
+                int right = child + 1;
+                if (right < n && compare(t[child], w[child], s[child], t[right], w[right], s[right]) > 0) {
+                    child = right;
+                }
+                if (compare(xt, xw, xs, t[child], w[child], s[child]) <= 0) {
+                    break;
+                }
+                t[k] = t[child];
+                s[k] = s[child];
+                w[k] = w[child];
+                k = child;
+            }
+            t[k] = xt;
+            s[k] = xs;
+            w[k] = xw;
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------------------------------- verify
+
+    /** Verify mode: the queue (array order), the pending list and the key count must equal the shadow's. */
+    public void verifyContents() {
+        if (this.shadow == null) {
+            return;
+        }
+        PackedTicks.check();
+        List<ScheduledTick<T>> mine = this.legacy != null ? this.legacy.queueInArrayOrder() : this.getAll().toList();
+        List<ScheduledTick<T>> old = this.shadow.queueInArrayOrder();
+        if (!PackedTicks.sameScheduled(mine, old)) {
+            PackedTicks.mismatch("queue new=" + mine + " old=" + old);
+        }
+        List<SavedTick<T>> oldPending = this.shadow.pendingTicks();
+        List<SavedTick<T>> myPending;
+        if (this.legacy != null) {
+            myPending = this.legacy.pendingTicks();
+        } else if (this.dWords == null) {
+            myPending = null;
+        } else {
+            myPending = new ArrayList<>(this.dSize);
+            for (int i = 0; i < this.dSize; i++) {
+                myPending.add(this.materializeSaved(i));
+            }
+        }
+        if ((myPending == null) != (oldPending == null) || (myPending != null && !PackedTicks.sameSaved(myPending, oldPending))) {
+            PackedTicks.mismatch("pending new=" + myPending + " old=" + oldPending);
+        }
+        int myKeys = this.legacy != null ? this.legacy.keyCount() : (this.keys != null ? this.keys.size() : -1);
+        if (myKeys >= 0 && myKeys != this.shadow.keyCount()) {
+            PackedTicks.mismatch("key count new=" + myKeys + " old=" + this.shadow.keyCount());
+        }
     }
 }
