+                            }
+                        });
+                    }
+                }
+            }
+        });
+        PotentialCalculator potentialCalculator = new PotentialCalculator();
+        Object2IntOpenHashMap<MobCategory> map = new Object2IntOpenHashMap<>();
+        for (MobCategory category : EVANGELIUM_CATEGORIES) {
+            int sum = 0;
+            for (int[] count : counts) sum += count[category.ordinal()];
+            map.put(category, sum);
+        }
+        for (java.util.ArrayList<Object> charge : charges) {
+            for (int i = 0; i < charge.size(); i += 2) {
+                potentialCalculator.addCharge((BlockPos) charge.get(i), (Double) charge.get(i + 1));
+            }
+        }
+        if (VERIFY_SPAWN_STATE) {   // test hook: the serial count (without touching player mob counts) must give the same numbers
