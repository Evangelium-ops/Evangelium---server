 import org.slf4j.Logger;
 
 public final class NaturalSpawner {
+    // Evangelium - near-first natural spawning without a serial walk. Paper (per-player mob spawns) tries a player's chunks nearest first, so
+    // when the monster cap is almost full the last free room goes to the chunks next to him (an AFK farm) and far chunks only get what the
+    // near ones left. Regions here spawn in parallel, so far chunks raced the near ones (a nether roof gold farm next to the player got about
+    // 40% fewer mobs). Emulated statistically: only when the room left (cap - count, the smallest over the players in range) is at most one
+    // pack, a chunk at Chebyshev chunk distance d > 2 from the nearest player in range tries with probability R^(d-2) (R fitted against
+    // Paper's spawn rates per distance ring, corner and centre of a region). With clear room nothing changes, so totals stay vanilla.
+    private static final boolean EVANGELIUM_NEAR_FIRST = io.evangelium.server.util.DevSwitch.on("spawn-distance-gate");
+    private static final double EVANGELIUM_GATE_R = Double.parseDouble(System.getProperty("evangeliumserver.spawnGateR", "0.75")); // hidden benchmark hook
+    private static final int EVANGELIUM_GATE_PACK = Integer.getInteger("evangeliumserver.spawnGatePack", 4); // the usual largest monster pack; hidden benchmark hook
+
+    private static boolean evangeliumGatePasses(ServerLevel level, SpawnState state, MobCategory category, int room, ca.spottedleaf.moonrise.common.list.ReferenceList<net.minecraft.server.level.ServerPlayer> inRange, ChunkPos pos) {
+        if (!EVANGELIUM_NEAR_FIRST || category != MobCategory.MONSTER || room > EVANGELIUM_GATE_PACK || inRange == null) {
+            return true;
+        }
+        int band = Integer.MAX_VALUE;
+        final long[] chunks = state.evangeliumPlayerChunks(level);
+        if (chunks.length < inRange.size()) { // a crowd: each chunk players stand in once
+            for (int k = 0; k < chunks.length && band > 2; k++) {
+                band = Math.min(band, Math.max(Math.abs(ChunkPos.getX(chunks[k]) - pos.x), Math.abs(ChunkPos.getZ(chunks[k]) - pos.z)));
+            }
+        } else {
+            final net.minecraft.server.level.ServerPlayer[] raw = inRange.getRawDataUnchecked();
+            for (int k = 0, len = Math.min(inRange.size(), raw.length); k < len && band > 2; k++) {
+                final net.minecraft.server.level.ServerPlayer player = raw[k];
+                if (player == null) continue;
+                final ChunkPos at = player.chunkPosition();
+                band = Math.min(band, Math.max(Math.abs(at.x - pos.x), Math.abs(at.z - pos.z)));
+            }
+        }
+        return band <= 2 || java.util.concurrent.ThreadLocalRandom.current().nextDouble() < Math.pow(EVANGELIUM_GATE_R, Math.min(band, 8) - 2);
+    }
