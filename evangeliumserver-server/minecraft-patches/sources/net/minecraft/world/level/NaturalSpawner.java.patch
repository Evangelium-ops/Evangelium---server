+        final int[][] counts = new int[shares][EVANGELIUM_CATEGORIES.length];
+        @SuppressWarnings("unchecked")
+        final java.util.ArrayList<Object>[] charges = new java.util.ArrayList[shares];   // BlockPos, Double, BlockPos, Double, ...
+        io.evangelium.server.threading.ParallelShares.run(shares, share -> {
+            final int[] count = counts[share];
+            final java.util.ArrayList<Object> charge = charges[share] = new java.util.ArrayList<>();
+            for (int i = (int) ((long) n * share / shares), end = (int) ((long) n * (share + 1) / shares); i < end; i++) {
+                final Entity entity = all.get(i);
+                if (!(entity instanceof Mob mob && (mob.isPersistenceRequired() || mob.requiresCustomPersistence()))) {
