     private static void saveTicks(CompoundTag tag, ChunkAccess.PackedTicks ticks) {
+        // Evangelium start - packed ticks: write PackedTickList straight to NBT (same tags), anything else through the codec
+        if (io.evangelium.server.ticks.PackedTicks.IO) {
+            writeTicks(tag, "block_ticks", BLOCK_TICKS_CODEC, net.minecraft.core.registries.BuiltInRegistries.BLOCK, ticks.blocks());
+            writeTicks(tag, "fluid_ticks", FLUID_TICKS_CODEC, net.minecraft.core.registries.BuiltInRegistries.FLUID, ticks.fluids());
+            return;
+        }
+        // Evangelium end
         tag.store("block_ticks", BLOCK_TICKS_CODEC, ticks.blocks());
         tag.store("fluid_ticks", FLUID_TICKS_CODEC, ticks.fluids());
     }
