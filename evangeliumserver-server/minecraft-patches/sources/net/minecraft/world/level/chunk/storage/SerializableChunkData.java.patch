+    // Evangelium start - packed ticks
+    private static <T> List<SavedTick<T>> readTicks(CompoundTag tag, String key, Codec<List<SavedTick<T>>> codec, net.minecraft.core.Registry<T> registry, ChunkPos chunkPos) {
+        List<SavedTick<T>> fast = io.evangelium.server.ticks.PackedTickIO.read(tag, key, registry, chunkPos);
+        if (fast == null || io.evangelium.server.ticks.PackedTicks.VERIFY) {
+            List<SavedTick<T>> slow = SavedTick.filterTickListForChunk(tag.read(key, codec).orElse(List.of()), chunkPos);
+            if (fast == null) {
+                return slow;
+            }
+            io.evangelium.server.ticks.PackedTicks.check();
+            if (!io.evangelium.server.ticks.PackedTicks.sameSaved(fast, slow)) {
+                io.evangelium.server.ticks.PackedTicks.mismatch("read " + key + " " + chunkPos + " fast=" + fast + " codec=" + slow);
+            }
+        }
+        return fast;
+    }
+
+    private static <T> void writeTicks(CompoundTag tag, String key, Codec<List<SavedTick<T>>> codec, net.minecraft.core.Registry<T> registry, List<SavedTick<T>> ticks) {
+        if (!io.evangelium.server.ticks.PackedTickIO.write(tag, key, registry, ticks)) {
+            tag.store(key, codec, ticks);
+        } else if (io.evangelium.server.ticks.PackedTicks.VERIFY) {
+            CompoundTag slow = new CompoundTag();
+            slow.store(key, codec, new java.util.ArrayList<>(ticks));
+            io.evangelium.server.ticks.PackedTicks.check();
+            if (!java.util.Objects.equals(slow.get(key), tag.get(key))) {
+                io.evangelium.server.ticks.PackedTicks.mismatch("write " + key + " fast=" + tag.get(key) + " codec=" + slow.get(key));
+            }
+        }
+    }
+    // Evangelium end
 
