+    /** Whether any loaded section the scan of findNearestBlock can read (a superset box) may hold the block. */
+    private boolean evangeliumMaybeInBox() {
+        if (net.minecraft.world.entity.ai.AiOptimizations.PLANT.equals("palette")) return false;
+        BlockPos center = this.removerMob.blockPosition();
+        LevelReader level = this.removerMob.level();
+        int range = this.evangeliumSearchRange(), vertical = this.evangeliumVerticalSearchRange();
+        int minSection = level.getMinSectionY(), maxSection = level.getMaxSectionY();
+        int sy0 = Math.max(minSection, (center.getY() - vertical - 1) >> 4), sy1 = Math.min(maxSection, (center.getY() + vertical) >> 4);
+        for (int cx = (center.getX() - range) >> 4; cx <= (center.getX() + range) >> 4; cx++) {
+            for (int cz = (center.getZ() - range) >> 4; cz <= (center.getZ() + range) >> 4; cz++) {
+                ChunkAccess chunk = level.getChunkIfLoadedImmediately(cx, cz);
+                if (chunk == null) continue;   // the scan treats an unloaded chunk as "not here"
+                net.minecraft.world.level.chunk.LevelChunkSection[] sections = chunk.getSections();
+                for (int sy = sy0; sy <= sy1; sy++) {
+                    net.minecraft.world.level.chunk.LevelChunkSection section = sections[sy - minSection];
+                    if (section != null && !section.hasOnlyAir() && section.maybeHas(state -> state.is(this.blockToRemove))) return true;
+                }
+            }
+        }
+        return false;
+    }
