     // only includes x/z axis
     // finds the closest poi data by distance. if multiple match the same distance, then they all are returned.
+    // Evangelium start - when no POI in the search box passes the type, occupancy and distance tests, the section walk can find
+    // nothing (and never calls the position predicate), so skip it. Reads each loaded POI chunk once instead of a BFS over
+    // every section in range; jobless villagers retry this every 1-2 s per behaviour.
+    /** Whether the last findClosest/findNearest call on this thread returned because no POI in the box passed type, occupancy and distance (AcquirePoi memo). */
+    private static final ThreadLocal<boolean[]> EVANGELIUM_NO_CANDIDATE = ThreadLocal.withInitial(() -> new boolean[1]);
+
+    public static boolean evangeliumLastNoCandidate() {
+        return EVANGELIUM_NO_CANDIDATE.get()[0];
+    }
+
+    private static boolean evangeliumNoCandidate(final PoiManager poiStorage, final Predicate<Holder<PoiType>> villagePlaceType,
+                                                final Predicate<? super PoiRecord> occupancyFilter, final BlockPos sourcePosition,
+                                                final int range, final double maxDistanceSquared,
+                                                final int lowerX, final int lowerZ, final int upperX, final int upperZ, final int lowerY, final int upperY) {
+        if (!io.evangelium.server.ai.AiDiagnostics.spatialOptimizationEnabled()) {
+            return false;
+        }
+        final ca.spottedleaf.moonrise.patches.chunk_system.scheduling.ChunkHolderManager holders =
+            ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)poiStorage.moonrise$getWorld()).moonrise$getChunkTaskScheduler().chunkHolderManager;
+        for (int chunkX = lowerX; chunkX <= upperX; ++chunkX) {
+            for (int chunkZ = lowerZ; chunkZ <= upperZ; ++chunkZ) {
+                final ca.spottedleaf.moonrise.patches.chunk_system.level.poi.PoiChunk chunk = holders.getPoiChunkIfLoaded(chunkX, chunkZ, true);
+                if (chunk == null) {
+                    continue;
+                }
+                for (int chunkY = lowerY; chunkY <= upperY; ++chunkY) {
+                    final Optional<PoiSection> section = chunk.getSectionForVanilla(chunkY);
+                    if (section.isEmpty()) {
+                        continue;
+                    }
+                    for (final Map.Entry<Holder<PoiType>, Set<PoiRecord>> entry : section.get().getData().entrySet()) {
+                        if (!villagePlaceType.test(entry.getKey())) {
+                            continue;
+                        }
+                        for (final PoiRecord poiData : entry.getValue()) {
+                            final BlockPos poiPosition = poiData.getPos();
+                            if (occupancyFilter.test(poiData)
+                                    && Math.abs(poiPosition.getX() - sourcePosition.getX()) <= range
+                                    && Math.abs(poiPosition.getZ() - sourcePosition.getZ()) <= range
+                                    && poiPosition.distSqr(sourcePosition) <= maxDistanceSquared) {
+                                return false;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        return true;
+    }
+    // Evangelium end
